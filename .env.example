# Configuration pour déploiement Sepolia
# IMPORTANT: Remplacez ces valeurs par vos vraies clés

# URL RPC Sepolia (Infura ou Alchemy)
SEPOLIA_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Clé privée de votre wallet de déploiement (SANS le préfixe 0x)
# ⚠️ ATTENTION: Utilisez un wallet de test, jamais votre wallet principal
PRIVATE_KEY=your_private_key_here_without_0x_prefix

# Clé API Etherscan pour la vérification (optionnel)
ETHERSCAN_API_KEY=your_etherscan_api_key

# Adresses des contrats (seront remplies après déploiement)
PORTFOLIO_TOKEN_ADDRESS=
PORTFOLIO_NFT_ADDRESS=
PFT_FAUCET_ADDRESS=
STAKING_MANAGER_ADDRESS=
NFT_MARKETPLACE_ADDRESS=

# Clés API Pinata pour IPFS
# Va sur https://app.pinata.cloud/keys pour obtenir tes clés
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key